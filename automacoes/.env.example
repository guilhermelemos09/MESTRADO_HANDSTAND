# Configurações de E-mail (Gmail)
# Substitua pelo seu endereço de e-mail do Gmail
GMAIL_USER=seu_email@gmail.com

# Senha de Aplicativo de 16 letras gerada no Google (sem espaços ou com espaços, o script trata automaticamente)
# Gere em: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
